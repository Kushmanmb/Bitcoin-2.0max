+      <div class="auth-tabs"><button id="loginTab" class="active" type="button">Sign in</button><button id="registerTab" type="button">Create account</button></div>
+      <form id="authForm">
+        <label id="nameField" hidden>Display name<input name="name" autocomplete="nickname" maxlength="40" placeholder="What should we call you?"></label>
+        <label>Email address<input name="email" type="email" autocomplete="username" maxlength="254" required placeholder="you@example.com"></label>
+        <label>Password<input name="password" type="password" autocomplete="current-password" minlength="12" maxlength="128" required placeholder="At least 12 characters"></label>
+        <p id="registerNotice" class="form-help" hidden>Your display name appears in chat. Email verification and password recovery are not available yet; keep your password safe.</p>
+        <p id="authError" class="error" role="alert"></p>
+        <button id="authSubmit" class="button primary full" type="submit">Enter command center <span>↗</span></button>
+      </form>
+      <div class="auth-foot">Your saved portfolio stays private. Messages in community rooms are shared with members.</div>
+      <p id="serviceStatus" class="service-status" role="status">Connecting to account service…</p>
+    </div><span class="auth-credit">BUILT TO EXPLORE. DESIGNED TO BELONG.</span></div>
+  </section>
+
+  <div id="app" class="app" hidden>
+    <aside id="sidebar" class="sidebar">
+      <a class="brand" href="index.html"><span class="brand-mark">₿</span><span>Bitcoin2.0<strong>Max</strong><small>PERSONAL COMMAND CENTER</small></span></a>
